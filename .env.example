UGC_BASE=https://www.ugc.fr
# Vide = l'adresse MAIL_USER. Gmail peut ensuite utiliser des alias avec des points.
# Sinon : domaines catch-all, séparés par des virgules.
CATCHALL_DOMAINS=
# auto = IMAP si MAIL_USER et MAIL_PASSWORD sont remplis.
# Sinon le lancement demande les adresses à coller.
MAIL_PROTOCOL=auto
# Vide = déduit de l'adresse (Gmail, Outlook, Hotmail, Yahoo, iCloud, GMX, Orange, Free, La Poste, SFR).
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
CAPTCHA_PROVIDER=capmonster
CAPTCHA_API_KEY=
CAPTCHA_USE_PROXY=0
PROXY_FILE=proxy.txt
# auto = actif si configuré, 0 = désactivé. USE_IMAP=0 force la saisie manuelle du lien.
USE_PROXY=auto
USE_IMAP=auto
MAIL_TIMEOUT_SEC=180
