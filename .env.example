UGC_BASE=https://www.ugc.fr
# Vide = l'adresse Gmail (IMAP_USER), puis des alias avec des points si on le demande.
# Sinon : domaines catch-all, séparés par des virgules.
CATCHALL_DOMAINS=
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_APP_PASSWORD=
CAPTCHA_PROVIDER=capmonster
CAPTCHA_API_KEY=
CAPTCHA_USE_PROXY=0
PROXY_FILE=proxy.txt
# auto = actif si configuré (proxies présents / mot de passe IMAP renseigné), 0 = désactivé
USE_PROXY=auto
USE_IMAP=auto
IMAP_TIMEOUT_SEC=180
